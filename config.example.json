{
  "jobs_dir": "jobs",
  "download": {
    "max_height": 1080
  },
  "transcription": {
    "model": "medium.en",
    "device": "cpu",
    "compute_type": "int8",
    "language": "en",
    "beam_size": 5,
    "condition_on_previous_text": false,
    "vad_filter": true,
    "vad_threshold": 0.35,
    "vad_min_silence_duration_ms": 2000,
    "vad_speech_pad_ms": 600,
    "hotwords": "Liverpool FC, Liverpool, Anfield, Arne Slot, Premier League, Champions League",
    "initial_prompt": "Liverpool FC football discussion. Preserve player names, manager names, club names, competitions, scorelines, and tactical terminology.",
    "max_chars": 84,
    "max_duration": 6.0,
    "review_gap_seconds": 2.0,
    "review_silence_noise_db": -35.0,
    "review_silence_min_duration": 0.6,
    "gap_recovery": true,
    "recovery_left_padding_seconds": [1.5, 6.0],
    "recovery_right_padding_seconds": 2.0,
    "recovery_min_probability": 0.45,
    "recovery_min_coverage_ratio": 0.35,
    "recovery_max_gap_seconds": 30.0
  },
  "subtitles": {
    "font_name": "PingFang SC",
    "chinese_font_size": 48,
    "english_font_size": 30,
    "margin_vertical": 58,
    "outline": 3,
    "shadow": 1
  },
  "render": {
    "video_encoder": "libx264",
    "preset": "medium",
    "crf": 20,
    "audio_bitrate": "192k"
  }
}
